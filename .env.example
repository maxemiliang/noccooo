# Local development only (make dev starts the Postgres and passes this). On maxcloud,
# DATABASE_URL comes from the db: entry in maxcloud.yaml (the db-app Secret) — never
# commit a real one.
DATABASE_URL=postgres://postgres:dev@127.0.0.1:55434/postgres
# make dev uses dev auth (no Cloudflare locally): the page's "You" dialog switches user.
# DEV_USER_EMAIL=maja@example.com
